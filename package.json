{
  "name": "@aglabo/.github",
  "version": "1.0.0",
  "description": ".github",
  "private": true,
  "type": "module",
  "keywords": [
    "oss",
    "development"
  ],
  "author": "atsushifx",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aglabo/.github.git"
  },
  "scripts": {
    "prepare": "bash ./scripts/setup-dev-env.sh",
    "scan:secrets": "concurrently \"betterleaks protect --config ./configs/betterleaks.toml\" \"secretlint --secretlintrc ./configs/secretlint.config.yaml .\"",

    "check:dprint": "dprint check",
    "format:dprint": "dprint fmt",

    "lint:gha": "pnpm run lint:gha:action && pnpm run lint:gha:gha",
    "lint:gha:action": "pnpm exec actionlint --config-file ./configs/actionlint.yaml --color",
    "lint:gha:gha": "pnpm exec ghalint run --config ./configs/ghalint.yaml && pnpm exec ghalint run-action --config ./configs/ghalint.yaml ",

    "lint:spells": "cspell --config .vscode/cspell.json --cache --cache-location .cache/cspell/cSpellCache ",
    "lint:text": "textlint --config ${XDG_CONFIG_HOME}/linters/textlint/textlintrc.yaml ",
    "lint:markdown": "markdownlint --config ${XDG_CONFIG_HOME}/linters/markdownlint/.markdownlint-cli2.yaml "
  }
}

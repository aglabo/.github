# default: ignore all files
*

## General
# Profile
!/profile
!/profile/*.md

# Allow README, LICENSE, CONTRIBUTING
!**/README*
!**/LICENSE*
!**/CONTRIBUTING*

# Allow .github directories
!.github/
!.github/**

# Allow git settings
!/.git*

# Allow other ignore
!*ignore

# Allow editorconfig
!**/.editorconfig

# Allow settings
!**/settings.json

## Allow Global Configs
# submodule path only: files inside the submodule follow its own .gitignore
!/global-configs

## Root configs
!**/package.json
!**/pnpm-lock.yaml
!**/renovate.json
!**/lefthook.yml
!**/dprint.jsonc
!**/.shellspec
!**/.mcp.json
!**/CHANGELOG.*
!**/Release-Note.*

## Project directories
# config files
!configs/
!configs/**
!configs/**/*.json
!configs/**/*.yml
!configs/**/*.yaml
!configs/**/*.toml
!configs/**/*rc
!configs/**/*.js
!configs/**/*.mjs

# runners & scripts
!/runners
!/runners/**
!/runners/**/*.sh
!/scripts
!/scripts/**
!/scripts/**/*.sh
!/scripts/**/*.ts

## AI Agents
# General
!**/AGENTS.md

# claude code
!**/CLAUDE*.md

# allowlist details: .claude/.gitignore
!.claude/
!**/CLAUDE*.md
!.claude/
!.claude/agents/
!.claude/agents/**
!.claude/rules/
!.claude/rules/**
!.claude/commands/
!.claude/commands/**

##  Editor
#   VSCode
!.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
!.vscode/cspell*
!.vscode/cspell*/**


##  Git
# allow all gitignore
!**/.gitignore


## Deny rules (keep last)
# default deny rules

#   OS specific files
.DS_Store
thumbs.db

#   logs, patches
**/*.log
**/*.diff
**/*.patch

#   history, cache
**/.history/
**/.cache/

#   backup/swap/temp
**/$~*
**/~*
**/*~
**/*.tmp
**/*.swp
**/*.lock

#   session files
**/*session.json
**/*session

#   .env files
**/.env*
!.env.example

#   temporary directories
**/temp
**/tmp

#   node
**/node_modules/
**/.pnpm-store/
